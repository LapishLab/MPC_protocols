\ MPC code for Tactile Aversion Choice (TAC) training and probably testing, tbd

\ **************************** Inputs ***************************
\ IR beams are numbered from left sipper to right sipper. Because
\ we are also recording licks, we will only record the three IR
\ beams closest to each sipper (middle two are dropped). Note
\ that on the Med Associates card, these inputs should be set to
\ level.

^tacSipBeam  = 4
^tacEntBeam = 3
^barSipBeam  = 8
^barEntBeam = 7

\ The licks are recorded for the matching sippers. Note that on
\ the Med Associates card, these inputs should be set to toggle.
^tacLick = 1
^barLick = 5
\ **************************** Outputs ***************************
^tacStimLight = 1                 \ The output number for the left stimulus light
^barStimLight = 2                \ The output number for the right stimulus light
^tacSipper = 5                    \ The output number for the left sipper when looking at the front of the chamber
^barSipper = 9                   \ The output number for the right sipper when looking at the front of the chamber
^PiSync = 7                        \ The output number for the sync signal to the raspberry Pi

\ *** List of variables and arrays ***

\  A = Timestamp for light on and PiSync "ON" times for CHOICE trials
\  B = Counters
\	B(0) = Total trial counter
\	B(1) = Forced trial counter
\	B(2) = Choice trial counter
\	B(3) = Number of tac choices
\	B(4) = Number of bar choices
\	B(5) = TAC lick counter
\	B(6) = Bar lick counter
\	B(7) = TAC entry beam break counter
\	B(8) = Bar entry beam break counter
\	B(9) = TAC sipper beam break counter
\	B(10) = Bar sipper beam break counter
\  C = List for intertrial interval (ITI) times
\  D = Variable selected for the ITIs each time
\  E = number of forced trials compared to choice
\  F = List for forced trial selection
\  G = Forced trial type (1 = TAC, 2 = Bar)
\  H = Timestamp for light on and PiSync "ON" times for FORCED trials
\  I = Counter for PiSync timestamp indexing
\  J = number of choice trials compared to forced
\  K = TAC lick timestamp array
\  L = Bar lick timestamp array
\  M = Trial types in order for the session (1 = TAC forced, 2 = Bar forced, 3 = Choice trial)
\  N = Engaged trial counter
\  O = TAC entry beam break timestamps
\  P = Bar entry beam break timestamps
\  Q = TAC sipper beam break timestamps
\  R = Bar sipper beam break timestamps
\  T = session time, used for time stamping and clock

\  Z1 = general start trigger
\  Z2 = TAC forced trial trigger
\  Z3 = Bar forced trial trigger
\  Z4 = Choice trial trigger
\  Z5 = decision tree for trial trigger
\  Z6 = lick counting trigger during both trial types

DIM A = 40
DIM B = 7
DIM H = 40
DIM K = 5000
DIM L = 5000
DIM M = 40

LIST C = 10", 22", 36", 50", 68"
LIST F = 1, 2


\  *******************************************************************
\        Set Up and Time Test Period(s)
\  *******************************************************************

S.S.1,

S1,

  #START: SET J = 4-E; Z1; Z5 ---> S2 \trigger start of session with issue

S2,

  0.01": Set T = T + 0.01; IF B(0) = 40 [@End,@Continue] \set clock T in seconds and end session when B(0) (trial counter) = 40
    @End: ---> S3
    @Continue: ---> S2
S3,

    10": ---> STOPABORTFLUSH
\  *******************************************************************
\        Decision tree for type of trials
\  *******************************************************************
S.S.2,
S1,
#Z5:--->S2
S2,
0.01":IF B(1) = E [@TRUE,@FALSE]
	@TRUE: SET B(1) = 0; Z4 --->S1
	@FALSE: RANDD G = F; IF G = 1 [@TRUE,@FALSE]
		@TRUE: Z2 ---> S1
		@FALSE: Z3 --->S1
\  *******************************************************************
\        Forced trial on TAC side
\  *******************************************************************
S.S.3,
S1,
#Z2: RANDD D = C --->S2
S2,
D#T: ON^tacStimLight, ^PiSync; ADD I; SET H(I) = T ---> S3
S3,
4": OFF^tacStimLight, ^PiSync ---> S4
S4,
1": ON^tacSipper; Z6 ---> S5
S5,
6.5": OFF^tacSipper; ADD B(0), B(1); SET M(B(0))=1; Z5 ---> S1
#R^tacLick: ADD N ---> SX
\  *******************************************************************
\        Forced trial on Bar side
\  *******************************************************************
S.S.4,
S1,
#Z3: RANDD D = C --->S2
S2,
D#T: ON^barStimLight, ^PiSync; ADD I; SET H(I) = T ---> S3
S3,
4": OFF^barStimLight, ^PiSync ---> S4
S4,
1": ON^barSipper; Z6 ---> S5
S5,
1.5": OFF^barSipper; ADD B(0), B(1); SET M(B(0))=2; Z5 ---> S1
#R^barLick: ADD N ---> SX
\  *******************************************************************
\        Choice trial between TAC or Bar side
\  *******************************************************************
S.S.5,
S1,
#Z4: ---> S2
S2,
0.01": RANDD D = C --->S3
S3,
D#T: ON^tacStimLight, ^barStimLight, ^PiSync; ADD I; SET A(I) = T ---> S4
S4,
4": OFF^tacStimLight, ^barStimLight, ^PiSync ---> S5
S5,
1": ON^tacSipper, ^barSipper; Z6 ---> S6
S6,
1.5": OFF^barSipper ---> SX
6.5": OFF^tacSipper ---> S7
#R^barLick: ADD B(4), N; OFF^tacSipper ---> SX
#R^tacLick: ADD B(3), N; OFF^barSipper ---> SX
S7,
0.01": ADD B(0), B(2); SET M(B(0))=3; IF B(2) = J [@TRUE, @FALSE]
	@TRUE: SET B(2) = O; Z5 ---> S1
	@FALSE: ---> S2
\  *******************************************************************
\       Lick counter and timestamp for TAC side
\  *******************************************************************
S.S.6,
S1,
#Z6: ---> S2
S2,
#R^tacLick: ADD B(5); SET K(B(5)) = T ---> S2
7": ---> S1
\  *******************************************************************
\       Lick counter and timestamp for Bar side
\  *******************************************************************
S.S.7,
S1,
#Z6: ---> S2
S2,
#R^barLick: ADD B(6); SET L(B(6)) = T ---> S2
7": ---> S1
\  *******************************************************************
\       Beam break counter and timestamp for TAC entries
\  *******************************************************************
S.S.8,
S1,
#Z1: ---> S2
S2,
#R^tacEntBeam: ADD B(7); SET O(B(7)) = T ---> S2
\  *******************************************************************
\       Beam break counter and timestamp for Bar entries
\  *******************************************************************
S.S.9,
S1,
#Z1: ---> S2
S2,
#R^barEntBeam: ADD B(8); SET P(B(8)) = T ---> S2
\  *******************************************************************
\       Beam break counter and timestamp for TAC near sipper
\  *******************************************************************
S.S.10,
S1,
#Z1: ---> S2
S2,
#R^tacSipBeam: ADD B(9); SET Q(B(9)) = T ---> S2
\  *******************************************************************
\       Beam break counter and timestamp for Bar near sipper
\  *******************************************************************
S.S.11,
S1,
#Z1: ---> S2
S2,
#R^barSipBeam: ADD B(10); SET R(B(10)) = T ---> S2