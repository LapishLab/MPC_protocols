\ CPP style program for analysis of tactile aversion floors
\ This program tracks the movement of the rats in the 2CAP chamber using the time of the beam breaks.
\ One rat per chamber will be allowed to move around freely for 15 minutes. No stimulus or anything else will be used.
\Left = TAC
\Right = bar
\  Place Preference Test w/ manual guillotine doors.
\  with optional acclimation period.  ALERTON is
\  used to signal the end of the acclimation and test
\  periods.  Turn the tone off with menu item Configure
\  Shut off Beep on teh MED-PC for Windows main menu.
\  The 15 beams on the test chamber have
\  been defined as follows.  Note, some
\  bemas have been defined as follows. Note, Some
\  beams hae been defined as exploratory vs entrance
\  The end most beams are used for general activity
\  only.  This coding may be modified if desired.

Activity beams??
^TAC1 = 4    \  Entrance Beam
^TAC2 = 3    \  Entrance Beam
^TAC3 = 2    \  Exploration Beam

^Bar1 = 6    \  Exploration Beam
^Bar2 = 7    \  Entrance Beam
^Bar3 = 8    \  Entrance Beam


\  Variables and Arrays () used in this procedure
\  V = Time value for time stamping arrays
\  J= LATENCY TO ENTER TA floor CHAMBER
\  K = LATENCY TO ENTER  bar floor CHAMBER
\  D= BIN 1 TIME bar CHAMBER
\  E= BIN 2 TIME bar CHAMBER
\  F= BIN 3 TIME bar CHAMBER
\  C= BIN 1 TIME TAC CHAMBER
\  H= BIN 2 TIME TAC CHAMBER
\  I= BIN 3 TIME TAC CHAMBER
\  B() = Bar Floor Zone Data
\      B(0) = Exploration Counts.  Label = barExpl
\    B(1) = Entrance Counts.  Label = barEntr
\    B(2) = Activity Counts.  Label = barAct
\    B(3) = zone Time.  Label = B_Tme
\  T = Data Collection time.  Label TESTTM.  Default 15 minutes
\  W() = TAC Floor Zone Data.  Same as Bar floor zone

\  Z-Pulses used in this procedure
\  Z1 = Signal start of data collection
\  Z3 = Signal TAC floor Entrance
\  Z4 = Signal Bar floor Entrance
\  Z5 = Signal end of Data Collection

\  L = Bar floor Entries TimeStamp
\  R = TAC floor Entries TimeStamp


\  N = Bar floor Expl TimeStamp
\  O = TAC floor Expl TimeStamp

\Binned Entry Count Data:
\M = Bar Bin 1 Entries
\Z = Bar Bin 2 Entries
\Q = Bar Bin 3 Entries

\Binned Entry Count Data:
\S = TAC Bin 1 Entries
\X = TAC Bin 2 Entries
\Y = TAC Bin 3 Entries


\  Dimension Arrays

DIM B = 5
DIM G = 5
DIM W = 5
DIM V = 4
DIM L = 500
DIM R = 500
DIM U = 500
DIM N = 500
DIM O = 500
DIM P = 500
DIM C = 4
DIM D = 4
DIM E = 4
DIM F = 4
\  *******************************************************************
\        Set Up and Time Test Period(s)
\  *******************************************************************

S.S.1,    
          
S1,

  #R^Bar1 ! #R^Bar2 ! #R^Bar3: Z1 ---> S2 \trigger start of session when rat is placed on bar floor side

S2,

  0.01": set T = T + 0.01; IF T >= 1200 [@End,@Continue] \set clock T in seconds and end session at 1200s (20 mins.)
    @End: ---> S3
    @Continue: ---> S2
S3,

	0.5": STOPABORTFLUSH ---> SX


\ ***************************************************************
\           Count Explorations, Entrances and Activity
\ ***************************************************************

S.S.2,    \ Wait for start signal Z1.  See variable definitions
    \ for various counters.  Signals Z2, Z3 & Z4 are issued
    \ when the animal moves from one zone to another.
S1,
  #Z1: ---> S2

S2,      \ Data Collection while in bar floor zone
  #R^Bar1 ! #R^Bar2 !  #R^Bar3 : ADD B(2) ---> SX \count Bar floor activity (e.g. beam breaks)
  #R^TAC2 ! #R^TAC1: ADD W(1); Set R(W(1))= T; Z3 ---> S3 \count and timestamp TAC floor entrance
  #R^TAC3: ADD W(0); Set O(W(0))= T ---> SX \count and timestamp TAC floor explore

S3,     \ Data Collection while in TAC floor zone

  #R^TAC1 ! #R^TAC2  ! #R^TAC3: ADD W(2) ---> SX \count TAC floor activity (e.g. beam breaks)
  #R^Bar2 ! #R^Bar3: ADD B(1); Set L(B(1))= T; Z4 ---> S2 \count and timestamp Bar floor entrance
  #R^Bar1: ADD B(0); Set N(B(0))= T ---> SX \count and timestamp Bar floor explore


\  **************************************************************
\                  Increment Zone Time
\  **************************************************************

S.S.3,    \  wait for start signal Z1
S1,
  #Z1: ---> S2

S2,    \  Bar floor Zone Time

  0.01": SET B(3) = B(3) + 0.01  ---> SX \count bar floor time
  #Z3: ---> S3 \if they make a TAC floor entry, stop adding bar floor time and start counting TAC floor time

S3,    \  TAC floor Zone Time

  0.01": SET W(3) = W(3) + 0.01 ---> SX \count TAC floor time
  #Z4: ---> S2 \if they make a bar floor entry, stop adding TAC floor time and start counting bar floor time


\***************************
\Show time of entry to chamber
\****************************
S.S.7,

S1,
#Z1---> S2

S2,
   #R^TAC2 ! #R^TAC1: SET J=T ---> S1


\***************
S.S.8,
S1,
   #Z1---> S2

S2,
   #R^Bar2 ! #R^Bar3: SET K=T --->S1


\********************
\time data into 5 min bins
\************************
S.S.9,

S1,
#Z1---> S2

S2,
   5' : SET D(0) = B(3); SET C(0) = W(3) ---> S3

S3,
   5' : SET D(1) = B(3); SET C(1) = W(3) ---> S4

S4,
   5' : SET D(2) = B(3); SET C(2) = W(3) ---> S5

S5,
   5' : SET D(3) = B(3); SET C(3) = W(3) ---> SX


\********************
\cumulative entrance data in 5 min bins
\************************
S.S.10,

S1,
#Z1---> S2

S2,
  5' : SET E(0) = B(1); SET F(0) = W(1) ---> S3

S3,
  5' : SET E(1) = B(1); SET F(1) = W(1) ---> S4

S4,
  5' : SET E(2) = B(1); SET F(2) = W(1) ---> S5

S5,
  5' : SET E(3) = B(1); SET F(3) = W(1) ---> SX



\********************
\white chamber entry time stamps
\************************
\S.S.12,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^TAC2 ! #R^TAC1: ADD W(1);Set R(W(1))= T ---> S2

\********************
\black chamber entry time stamps
\************************
\S.S.13,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^Bar2 ! #R^Bar3: ADD B(1);Set L(B(1))= T ---> S2

\********************
\gray chamber entry time stamps
\************************
\S.S.14,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \#R^Gray8 ! #R^Gray9:  ADD G(1);Set U(G(1))= T ---> S2

\********************
\white chamber expl time stamps
\************************
\S.S.15,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^TAC3: ADD W(0);Set O(W(0))= T ---> S2
\********************
\black chamber expl time stamps
\************************
\S.S.16,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^Bar1: ADD B(0);Set N(B(0))= T ---> S2

S.S.5,

SHOW 13,tacEntr, W(1), ; SHOW 19,barAct, B(2),  SHOW 8,tacExpl, W(0);; SHOW 18,tacAct, W(2) SHOW 14,barEntr, B(1); SHOW 9,barExpl, B(0);Show2,G_TME,G(3), 3,W_TME,W(3), 4,B_TME,B(3); SHOW 20,FIRSTENTWHITE,J, ; SHOW 21,FIRSTENTBLACK,K