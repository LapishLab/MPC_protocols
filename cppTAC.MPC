\ CPP style program for analysis of tactile aversion floors
\ This program tracks the movement of the rats in the 2CAP chamber using the time of the beam breaks.
\ One rat per chamber will be allowed to move around freely for 15 minutes. No stimulus or anything else will be used.
\Left = TAC
\Right = bar
\  Place Preference Test w/ manual guillotine doors.
\  with optional acclimation period.  ALERTON is
\  used to signal the end of the acclimation and test
\  periods.  Turn the tone off with menu item Configure
\  Shut off Beep on teh MED-PC for Windows main menu.
\  The 15 beams on the test chamber have
\  been defined as follows.  Note, some
\  bemas have been defined as follows. Note, Some
\  beams hae been defined as exploratory vs entrance
\  The end most beams are used for general activity
\  only.  This coding may be modified if desired.


^Left1 = 4    \  Entrance Beam
^Left2 = 3    \  Entrance Beam
^Left3 = 2    \  Exploration Beam

^Right4 = 6    \  Exploration Beam
^Right5 = 7    \  Entrance Beam
^Right6 = 8    \  Entrance Beam


\  Variables and Arrays () used in this procedure
\  V = Time value for time stamping arrays
\  J= LATENCY TO ENTER Left CHAMBER
\  K = LATENCY TO ENTER  Right CHAMBER
\  D= BIN 1 TIME Right CHAMBER
\  E= BIN 2 TIME Right CHAMBER
\  F= BIN 3 TIME Right CHAMBER
\  C= BIN 1 TIME Left CHAMBER
\  H= BIN 2 TIME Left CHAMBER
\  I= BIN 3 TIME Left CHAMBER
\  A = Adaptation period.  Label ADAPT.  Default = 5 minutes
\  B() = Black Zone Data
\      B(0) = Exploration Counts.  Label = B_Expl
\    B(1) = Entrance Counts.  Label = B_Entr
\    B(2) = Activity Counts.  Label = B_Actv
\    B(3) = zone Time.  Label = B_Tme
\  G() = Gray Zone Data.  Same as Black
\  T = Data Collection time.  Label TESTTM.  Default 15 minutes
\  W() = White Zone Data.  Same as Black

\  Z-Pulses used in this procedure
\  Z1 = Signal start of data collection
\  Z2 = Signal Gray Entrance
\  Z3 = Signal White Entrance
\  Z4 = Signal Black Entrance
\  Z5 = Signal end of Data Collection

\  L = Black Entries TimeStamp
\  R = White Entries TimeStamp
\  U = Gray Entries TimeStamp

\  N = Black Expl TimeStamp
\  O = White Expl TimeStamp
\  P = Gray Expl TimeStamp

\Binned Entry Count Data:
\M = Black Bin 1 Entries
\Z = Black Bin 2 Entries
\Q = Black Bin 3 Entries

\Binned Entry Count Data:
\S = White Bin 1 Entries
\X = White Bin 2 Entries
\Y = White Bin 3 Entries


\  Dimension Arrays

DIM B = 5
DIM G = 5
DIM W = 5
DIM V = 4
DIM L = 500
DIM R = 500
DIM U = 500
DIM N = 500
DIM O = 500
DIM P = 500

\  *******************************************************************
\        Set Up and TIme Test Period(s)
\  *******************************************************************

S.S.1,    \  set default value for adaptation time "A" (5 min)
          \  and total test time "T" (15 min).
S1,
    .01": Set A = 0, T = 20 ---> S2

S2,     \ First Statement:  Wait for START command, Change
        \  times to seconds, and proceed to S3 or S4
        \ Second Statement:  Update show display in case
        \  either variable "A" or "T" is changed.

  #START: SET A = A*60, T = T*60; If A = 0 [@NoAdapt,@StartAdapt]
    @NoAdapt: ---> S3
    @StartAdapt: ---> S4
  1": SHOW 1,ADAPT,A, 2,TESTTM,T ---> SX

S3,    \  Starting without Adaptation period.
    \  Start Test Time when animal placed
    \  in gray zone and issue signal Z1.

  #R^Gray7 ! #R^Gray8 ! #R^Gray9: Z1 ---> S6

S4,    \  Start Adaptation when animal placed in gray zone..

  #R^Gray7 ! #R^Gray8 ! #R^Gray9: Z1 ---> S5

S5,    \  Time Adaptation Period.
    \  Signal End of Adaptation Period with computer "beep"
    \  so that manual doors may be opened and issue signal Z1.

  1": SUB A; SHOW 1,ADAPT,A/60;
    IF A <= 0 [@StartTest,@ContnueAdapt]
    @Start: SHOW 1,TESTTM,T/60; Z1 ---> S6
    @Cont: ---> SX

S6,     \  Time Test Period.  Close doors and issue end of session
        \  signal 25 when test complete.

  1": SUB T; SHOW 1, TESTTM,T/60;
    IF T <= 0 [@EndTest,@ContinueTest]
    @End: Z5 ---> S7
    @Cont: ---> SX

S7,     \  Allow time for screen update, terminate procedure
    \  and save data.  If an automatic printout is desired
    \  add the command PRINT to the @End statement above.
    \  Also see the commands PRINTVARS, PRINTFOMAT, PRINTCOLUMNS,
    \  and associated DISK commands as well as file saving options
    \  in the USERS guide and help files.

  2":  ---> STOPABORTFLUSH

\ ***************************************************************
\           Count Explorations, Entrances and Activity
\ ***************************************************************

S.S.2,    \ Wait for start signal Z1.  See variable definitions
    \ for various counters.  Signals Z2, Z3 & Z4 are issued
    \ when the animal moves from one zone to another.
S1,
  #Z1: ---> S2

S2,     \ Data Collection while in gray zone

  #R^White5 ! #R^White4: ADD W(1); SHOW 13,W_ENTR, W(1);Set R(W(1))= V(1); Z3 ---> S3
  #R^White6: ADD W(0); SHOW 8,W_EXPL, W(0); Set O(W(0))= V(1) ---> SX
  #R^Black11 ! #R^Black12: ADD B(1); SHOW 14,B_ENTR, B(1); Set L(B(1))= V(1); Z4 ---> S4
  #R^Black10: ADD B(0); SHOW 9,B_EXPL, B(0); Set N(B(0))= V(1) ---> SX
  #R^Gray8:  ADD G(2); SHOW 17,G_ACTV, G(2) ---> SX
  #R^Gray7 ! #R^Gray9:  ADD G(2); SHOW 17,G_ACTV,G(2) ---> SX
  #Z5: ---> S5

S3,     \ Data Collection While in white zone

  #R^Gray8 ! #R^Gray9:  ADD G(1); SHOW 12,G_ENTR,G(1); Set U(G(1))= V(1); Z2 ---> S2
  #R^Gray7: ADD G(0); SHOW 7,G_EXPL, G(0); Set P(G(0))= V(1) ---> SX
  #R^White1  ! #R^White2: ADD W(2); SHOW 18,W_ACTV, W(2) ---> SX
  #R^White3  ! #R^White4: ADD W(2); SHOW 18,W_ACTV, W(2) ---> SX
  #R^White5  ! #R^White6: ADD W(2); SHOW 18,W_ACTV, W(2) ---> SX
  #Z5: ---> S5

S4,     \ Data Collection While in black zone
  #R^Gray8 ! #R^Gray9:  ADD G(1); SHOW 12,G_ENTR,G(1); Z2 ---> S2
  #R^Gray9: ADD G(0); SHOW 7,G_EXPL, G(0); Set P(G(0))= V(1) ---> SX
  #R^Black10  ! #R^Black11: ADD B(2); SHOW 19,B_ACTV, B(2) ---> SX
  #R^Black12  ! #R^Black13: ADD B(2); SHOW 19,B_ACTV, B(2) ---> SX
  #R^Black14  ! #R^Black15: ADD B(2); SHOW 19,B_ACTV, B(2) ---> SX
  #Z5: ---> S5

S5,
  1': ---> SX

\  **************************************************************
\                  Increment Zone Time
\  **************************************************************

S.S.3,    \  wait for start signal Z1.  Initialize screen displays.
S1,
  #Z1:  Show2,G_TME,G(3), 3,W_TME,W(3), 4,B_TME,B(3) ---> S2

S2,    \  Gray Zone Time

  .1": SET G(3) = G(3) + 0.1; SHOW 2,G_TME,G(3) ---> SX
  #Z3: SET G(3) = G(3) + 0.05; SHOW 2,G_TME,G(3) ---> S3
  #Z4: SET G(3) = G(3) + 0.05; SHOW 2,G_TME,G(3) ---> S4
  #Z5: ---> S5

S3,    \  White Zone Time

  .1": SET W(3) = W(3) + 0.1; SHOW 3,W_TME,W(3) ---> SX
  #Z2: SET W(3) = W(3) + 0.05; SHOW 3,W_TME,W(3) ---> S2
  #Z5: ---> S5

S4,    \  Black Zone Time

  .1": SET B(3) = B(3) + 0.1; SHOW 4,B_TME,B(3) ---> SX
  #Z2: SET B(3) = B(3) + 0.05; SHOW 4,B_TME,B(3) ---> S2
  #Z5: ---> S5

S5,    \  Holding state at end of procedure

  1': ---> SX

\***************************
\Show time of entry to chamber
\****************************
S.S.7,

S1,
#Z1---> S2

S2,
   #R^White5 ! #R^White4: SET J=T; SHOW 20,FIRSTENTWHITE,J---> S3

S3,
  #Z5: ---> S4

S4,    \  Holding state at end of procedure

  1': ---> SX

\***************
S.S.8,
S1,
   #Z1---> S2

S2,
   #R^Black11 ! #R^Black12: SET K=T; SHOW 21,FIRSTENTBLACK,K--->S3

S3,
  #Z5: ---> S4

S4,    \  Holding state at end of procedure

  1': ---> SX

\********************
\bins time data into 5 min bin
\************************
S.S.9,

S1,
#Z1---> S2

S2,
   5' : SET D = B(3); SHOW 22, BIN1BLACK,D; SET c = W(3); SHOW 23, BIN1WHITE,c ---> S3

S3,
   5' :  SET E = B(3); SHOW 24, BIN2BLACK,E; SET H = W(3); SHOW 25, BIN2WHITE,H ---> S4

S4,
   5' :  SET F = B(3); SHOW 26, BIN3BLACK,F; SET I = W(3); SHOW 27, BIN3WHITE,I ---> S5

S5,
#Z5: ---> S6

S6,    \  Holding state at end of procedure

  1': ---> SX

\********************
\cumulative entrance data in 5 min bins
\************************
S.S.10,

S1,
#Z1---> S2

S2,
  5' : SET M = B(1); SHOW 28, BIN1Bent,M; SET S = W(1); SHOW 29, BIN1Went,S ---> S3

S3,
  5' : SET Z = B(1); SHOW 30, BIN2Bent,Z; SET X = W(1); SHOW 31, BIN2Went,X ---> S4

S4,
  5' : SET Q = B(1); SHOW 32, BIN3Bent,Q; SET Y = W(1); SHOW 33, BIN3Went,Y ---> S5

S5,
#Z5: ---> S6

S6,    \  Holding state at end of procedure

  1': ---> SX

\********************
\white chamber entry time stamps
\************************
\S.S.12,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^White5 ! #R^White4: ADD W(1);Set R(W(1))= V(1) ---> S2

\********************
\black chamber entry time stamps
\************************
\S.S.13,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^Black11 ! #R^Black12: ADD B(1);Set L(B(1))= V(1) ---> S2

\********************
\gray chamber entry time stamps
\************************
\S.S.14,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \#R^Gray8 ! #R^Gray9:  ADD G(1);Set U(G(1))= V(1) ---> S2

\********************
\white chamber expl time stamps
\************************
\S.S.15,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^White6: ADD W(0);Set O(W(0))= V(1) ---> S2
\********************
\black chamber expl time stamps
\************************
\S.S.16,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \ #R^Black10: ADD B(0);Set N(B(0))= V(1) ---> S2

\********************
\gray chamber expl time stamps a
\************************
\S.S.17,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \#R^Gray7:  ADD G(0);Set P(G(0))= V(1) ---> S2
\********************
\gray chamber expl time stamps b
\************************
\S.S.18,
 \   S1,
  \  #Start:--->S2
   \ S2,
    \#R^Gray9:  ADD G(0);Set P(G(0))= V(1) ---> S2
\********************
\event clock
\************************
S.S.11,
    S1,
    #Z1:--->S2
    S2,
    0.01": Set V(1) = V(1) + 0.01 ---> SX
